# Copiar como .env  (VITE_* es PÚBLICO, no poner secretos)

# URL base de la API (sin barra final)
VITE_API_URL=http://localhost:8000/api/v1

# Cache de TanStack Query (ms)
VITE_QUERY_STALE_TIME=30000

# Nombre de la aplicación (marca visible en login/landing)
VITE_APP_NAME=Laboratorio de Tecnología Diesel
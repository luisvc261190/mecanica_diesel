# ============================================================================
# Copiar como .env  (NUNCA subir .env a Git)
# El prefix DATABASE_URL usa psycopg3. En Neon, pega el string del proyecto y
# cambia el esquema a postgresql+psycopg:// (async) cuando haga falta.
# ============================================================================

ENVIRONMENT=development

# --- Base de datos (async para la app) ---
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech:5432/ltd?sslmode=require

# --- Revisión del esquema: ruta al SQL baseline (repo root / base_datos) ---
SCHEMA_BASELINE_FILE=base_datos/04_schema.sql

# --- Seguridad ---
JWT_SECRET_KEY=change_me_in_production_64_chars_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS: separados por coma para varios origenes ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Storage ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_MIMES=image/jpeg,image/png,image/webp,application/pdf

# --- Logging ---
LOG_LEVEL=INFO

# --- Rate limiting (reserva; ver nuclei/api/deps.py) ---
RATE_LIMIT_ENABLED=false